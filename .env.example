# CadSwarm's optional settings. Nothing here is needed to install or use CADSwarm.
#
# The AI helpers run on `claude`, `codex` or `opencode` with the sign-in each CLI already has on this
# computer, and SpacetimeDB uses its CLI's own stored login (`spacetime login`). There is no key to
# paste and no file to create before starting a team.
#
# This file only lists extras: the demo's third-party services, a machine that cannot sign in
# interactively, and developer overrides. Put values wherever the command runs:
#   - cadswarm.env next to the checkout(s), e.g. Projects\cadswarm.env, shared by every worktree
#   - or .env inside one checkout (git-ignored)
# and load them for one command (a missing file is not an error):
#   powershell -File scripts\with-env.ps1 python -m pytest -q
#   powershell -File scripts\with-env.ps1 host\target\release\cadswarm-host.exe --data .\team run
# or just set the same names yourself (`$env:CADSWARM_PROJECT_LIMIT_GB = "50"`).

# --- Optional demo services -----------------------------------------------------------
# The perch demo's design-memory recall and the Creao/Factory agent cards read these; the
# normal CADSwarm flow never does.
# ELASTIC_URL=
# ELASTIC_API_KEY=
# KIBANA_URL=
# CREAO_API_KEY=
# CREAO_AGENT_ID=

# --- A machine with no interactive CLI sign-in (optional) ------------------------------
# The helper CLIs themselves read these; CADSwarm does not. Prefer the normal sign-in.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Publishing a release from a headless machine (optional) ---------------------------
# The release workflow uses GitHub's own token. This is only for `gh release create` by hand.
# GH_TOKEN=

# --- SpacetimeDB is not an API key ----------------------------------------------------
# Maincloud publishing and hosting use the CLI's stored login. CADSWARM_HOST_TOKEN overrides that
# token for a headless host (development only).
# CADSWARM_HOST_TOKEN=

# --- Developer overrides (not secrets) -------------------------------------------------
# CADSWARM_FREECAD_PYTHON=C:\Program Files\FreeCAD 1.1\bin\python.exe
# CADSWARM_RELEASE_BASE=file:///C:/path/to/dist
# CADSWARM_HOST_BIN=
# SPACETIME_BIN=
# CADSWARM_MODULE_WASM=
# CADSWARM_DEPS=
# CADSWARM_PROJECT=
# CADSWARM_OPENCODE=
# CADSWARM_BOARDS=
# CADSWARM_CCX=
# CADSWARM_PROJECT_LIMIT_GB=
# PYTHON=
